pub fn toString(c: char) -> str /{
    void *buf = malloc(5);
    uint32_to_utf8_str(c, (char*)buf, 5);
    return addStaticStringToHeap(buf);
}/

pub fn isAlpha(c: char) -> bool /{
    char buf[5];
    uint32_to_utf8_str(c, buf, sizeof(buf));
    return ((buf[0] >= 'a' && buf[0] <= 'z') || (buf[0] >= 'A' && buf[0] <= 'Z'));
}/

pub fn isNumber(c: char) -> bool /{
    char buf[5];
    uint32_to_utf8_str(c, buf, sizeof(buf));
    return (buf[0] >= '0' && buf[0] <= '9');
}/

pub  fn eq(a: char, b: char) -> bool /{
    $include(<string.h>)
    $inline()

    return a == b;
}/