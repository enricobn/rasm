// from https://stackoverflow.com/questions/8465006/how-do-i-concatenate-two-strings-in-c
pub fn add(s1: str, s2: str) -> str /{
    $include(<stdlib.h>)
    $include(<string.h>)

    char* s1_ = (char *)$s1->address;
    char* s2_ = (char *)$s2->address;

    int len_ = strlen(s1_) + strlen(s2_);

    struct RasmPointer_ *result = rasmMalloc(sizeof(char) * (len_ + 1)); // +1 for the null-terminator
    // in real code you would check for errors in malloc here
    strcpy(result->address, s1_);
    strcat(result->address, s2_);
    ((char *)result->address)[len_] = 0;
    return result;
}/

pub fn add(s: str, c: char) -> str /{
    $include(<stdlib.h>)
    $include(<string.h>)

    char* s_ = (char *)$s->address;
    
    char buf[5];
    uint32_to_utf8_str(c, buf, sizeof(buf));

    int len_ = strlen(s_) + strlen(buf);

    struct RasmPointer_ *result = rasmMalloc(sizeof(char) * (len_ + 1)); // +1 for the null-terminator
    // in real code you would check for errors in malloc here
    strcpy(result->address, s_);
    strcat(result->address, buf);
    ((char *)result->address)[len_] = 0;
    return result;
}/

// from https://stackoverflow.com/questions/26080829/detecting-strtol-failure
pub fn toInt(s: str) -> Option<int> /{
    $include(<errno.h>)

    char *end = NULL;
    char* s_ = (char *)$s->address;

    errno = 0;
    int result = (int) strtol(s_, &end, 10);

    if (errno == 0 && s_ && !*end) {
        return $call(Some, result);
    } else {
        // a "typed" None based on the typed return value of the function
        return $enumSimple(None);
    }
}/

pub fn eq(s1: str, s2: str) -> bool /{
    $include(<string.h>)
    $inline()

    char* s1_ = (char *)$s1->address;
    char* s2_ = (char *)$s2->address;

    return (strcmp(s1_, s2_) == 0);
}/

// TODO does it work for UTF-8?
pub fn less(s1: str, s2: str) -> bool /{
    $include(<string.h>)
    $inline()

    char* s1_ = (char *)$s1->address;
    char* s2_ = (char *)$s2->address;

    return (strcmp(s1_, s2_) < 0);
}/

// TODO does it work for UTF-8?
pub fn greater(s1: str, s2: str) -> bool /{
    $include(<string.h>)
    $inline()

    char* s1_ = (char *)$s1->address;
    char* s2_ = (char *)$s2->address;

    return (strcmp(s1_, s2_) > 0);
}/

pub fn len(s: str) -> int /{
    $include(<string.h>)

    char* s_ = (char *)$s->address;

    int len_ = strlen(s_);
    int i = 0;
    int count = 0;
    while (i < len_) {
        char lb = s_[i];
        if (( lb & 0x80 ) == 0 ) {         // lead bit is zero, must be a single ascii
           i += 1;
           count += 1;
        } else if (( lb & 0xE0 ) == 0xC0 ) { // 110x xxxx
          i += 2;
          count += 1;
        } else if (( lb & 0xF0 ) == 0xE0 ) { // 1110 xxxx
          i += 3;
          count += 1;
        } else if (( lb & 0xF8 ) == 0xF0 ) { // 1111 0xxx
          i += 4;
          count += 1;
        } else {
            // TODO handle error?
           printf( "Unrecognized lead byte (%02x)\n", lb );
           return -1;
       }
    }
    return count;
}/

/**
 * string len in bytes
 */
internal fn byteLen(s: str) -> int /{
    $include(<string.h>)
    char* s_ = (char *)$s->address;
    return strlen(s_);
}/

/**
 *  returns the offset (in bytes, not chars) of the next char
 *  given an offset from the start of the string.
 *  Returns 0 if it's the end of the string.
 *  TODO handle beyond the end of the string.
 **/
internal fn nextChar(s: str, offset: int) -> int /{
    $include(<string.h>)
    char* s_ = (char *)$s->address;
    unsigned char c = (unsigned char)s_[offset];
    if (c == 0) return 0;
    if ((c & 0x80) == 0) return offset + 1;
    if ((c & 0xE0) == 0xC0) return offset + 2;
    if ((c & 0xF0) == 0xE0) return offset + 3;
    if ((c & 0xF8) == 0xF0) return offset + 4;
    return offset + 1;
}/

/**
 * get the char at precise byte position
 */
internal fn getCharAt(s: str, pos: int) -> Option<char> /{
    $include(<string.h>)
    char* s_ = (char *)$s->address;
    int len = strlen(s_);
    if (pos < 0 || pos >= len) {
        return $enumSimple(None);
    }
    unsigned char b = (unsigned char)s_[pos];
    uint32_t c;
    if (b < 0x80) {
        c = b;
    } else if ((b & 0xE0) == 0xC0) {
        if (pos+1 >= len) return $enumSimple(None);
        c = (b & 0x1F) << 6;
        c |= ((unsigned char)s_[pos+1] & 0x3F);
    } else if ((b & 0xF0) == 0xE0) {
        if (pos+2 >= len) return $enumSimple(None);
        c = (b & 0x0F) << 12;
        c |= (((unsigned char)s_[pos+1] & 0x3F) << 6);
        c |= ((unsigned char)s_[pos+2] & 0x3F);
    } else if ((b & 0xF8) == 0xF0) {
        if (pos+3 >= len) return $enumSimple(None);
        c = (b & 0x07) << 18;
        c |= (((unsigned char)s_[pos+1] & 0x3F) << 12);
        c |= (((unsigned char)s_[pos+2] & 0x3F) << 6);
        c |= ((unsigned char)s_[pos+3] & 0x3F);
    } else {
        return $enumSimple(None);
    }
    return $call(Some, c);
}/

// from https://stackoverflow.com/questions/2114377/copying-a-part-of-a-string-substring-in-c
// TODO it does not work for UTF-8
pub fn substr(s: str, pos: int, len: int) -> Option<str> /{
    $include(<stdlib.h>)
    $include(<string.h>)

    char* s_ = (char *)$s->address;

    int input_len = strlen (s_);

    if (pos + len > input_len)
    {
        // a "typed" None based on the typed return value of the function
        return $enumSimple(None);
    }

    struct RasmPointer_ *dest = rasmMalloc((sizeof(char)) * len + 1);

    strncpy(dest->address, s_ + pos, len);
    ((char *)dest->address)[len] = 0;

    return $call(Some, dest:str);
}/