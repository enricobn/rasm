pub fn toFloat(n: int) -> float /{
    $inline()
    return ((float) $n);
}/

pub fn toInt(n: float) -> Option<int> /{
    int result = (int)$n;
    return $call(Some, result)
    ;
}/

pub fn divf(n1: int, n2: int) -> float /{
    $inline()
    return (((float)$n1) / ((float) $n2));
}/

pub fn sub(a: float, b: float) -> float /{
    $inline()
    return ($a - $b);
}/

pub fn add(a: float, b: float) -> float /{
    $inline()
    return ($a + $b);
}/

pub fn add(a: float, b: int) -> float /{
    $inline()
    return ($a + $b);
}/

pub fn mul(a: float, b: float) -> float /{
    $inline()
    return ($a * $b);
}/

pub fn div(a: float, b: float) -> float /{
    $inline()
    return ($a / $b);
}/

pub fn sub(a: float, b: int) -> float /{
    $inline()
    return ($a - $b);
}/

pub fn sub(a: int, b: float) -> float /{
    $inline()
    return ($a - $b);
}/

pub fn greater(a: float, b: float) -> bool /{
    $inline()
    return ($a > $b);
}/

pub fn greater(a: float, b: int) -> bool /{
    $inline()
    return ($a > $b);
}/

pub fn less(a: float, b: float) -> bool /{
    $inline()
    return ($a < $b);
}/

pub fn less(a: float, b: int) -> bool /{
    $inline()
    return ($a < $b);
}/

pub fn mul(f1: float, n2: int) -> float /{
    $inline()
    return ($f1 * $n2);
}/

pub fn div(a: float, b: int) -> float /{
    $inline()
    return ($a / $b);
}/

// from https://stackoverflow.com/questions/8257714/how-can-i-convert-an-int-to-a-string-in-c
pub fn toString(n: float) -> str /{
    // TODO calculate max length
    // $include(<math.h>)
    // int s_len = (int)((ceil(log10((double)$n));

    int s_len = 20;

    struct RasmPointer_ *_str = rasmMalloc((s_len + 1) * sizeof(char));
    sprintf(_str->address, "%.9f", $n);
    return _str;
}/

pub fn toFloat(s: str) -> Option<float> /{
    char* pEnd;
    float f = strtof((char*)s->address, &pEnd);
    if (errno == 0) {
        return $call(Option::Some<float>, f: float);
    } else {
        return $call(Option::None<float>);
    }
}/