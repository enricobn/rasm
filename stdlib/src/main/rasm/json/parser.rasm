@eq()
@toString()
pub enum JsonValue {
    JsonString(s: str),
    JsonNumber(number: Number),
    JsonFloat(f: float),
    JsonBoolean(b: bool),
    JsonNull,
    JsonObject(values: Vec<Pair<str, JsonValue>>),
    JsonArray(a: Vec<JsonValue>)
}

@eq()
@toString()
pub enum Number {
    Int(value: int),
    Float(value: float)
}

enum InternalResult {
    Ok(value: JsonValue, index: int),
    Error(e: str)
}

pub fn jsonParse(s: str) -> Result<JsonValue, str> {
    let chars = s.charsVec
    parseValue(chars, 0).match(
        fn(value, index) {
            let finalIndex = skipSpaces(chars, index)
            if(finalIndex.eq(chars.len), {
                Ok(value)
            }, {
                Error("Unexpected characters after JSON document")
            })
        },
        fn(e) {
            Error(e)
        }
    )
}

fn isSpace(c: char) -> bool {
    c.eq(' ').or(c.eq('\t')).or(c.eq('\n')).or(c.eq('\r'))
}

fn skipSpaces(chars: Vec<char>, index: int) -> int {
    while(index, fn(i) {
        chars.get(i).match(fn(c) {
            if(isSpace(c), { Some(i.add(1)) }, { None() })
        }, {
            None()
        })
    })
}

fn parseValue(chars: Vec<char>, index: int) -> InternalResult {
    let i = skipSpaces(chars, index)
    chars.get(i).match(fn(c) {
        if(c.eq('"'), {
            parseString(chars, i.add(1))
        }).elseIf(c.eq('{'), {
            parseObject(chars, i.add(1))
        }).elseIf(c.eq('['), {
            parseArray(chars, i.add(1))
        }).elseIf(c.eq('-').or(c.isNumber), {
            parseNumber(chars, i)
        }).elseIf(c.eq('t').or(c.eq('f')), {
            parseBoolean(chars, i)
        }).elseIf(c.eq('n'), {
            parseNull(chars, i)
        }).else({
            InternalResult::Error("Unexpected character while parsing JSON")
        }).call
    }, {
        InternalResult::Error("Unexpected end of input")
    })
}

fn parseString(chars: Vec<char>, index: int) -> InternalResult {
    parseStringInner(chars, index, "")
}

fn parseStringInner(chars: Vec<char>, index: int, actual: str) -> InternalResult {
    chars.get(index).match(fn(c) {
        if(c.eq('"'), {
            InternalResult::Ok(JsonString(actual), index.add(1))
        }).elseIf(c.eq('\\'), {
            parseEscape(chars, index, actual)
        }).else({
            parseStringInner(chars, index.add(1), actual.append(c))
        }).call
    }, {
        InternalResult::Error("Unterminated string")
    })
}

fn parseEscape(chars: Vec<char>, index: int, actual: str) -> InternalResult {
    chars.get(index.add(1)).match(fn(c) {
        if(c.eq('"'), {
            parseStringInner(chars, index.add(2), actual.append('"'))
        }).elseIf(c.eq('\\'), {
            parseStringInner(chars, index.add(2), actual.append('\\'))
        }).elseIf(c.eq('/'), {
            parseStringInner(chars, index.add(2), actual.append('/'))
        }).elseIf(c.eq('n'), {
            parseStringInner(chars, index.add(2), actual.append('\n'))
        }).elseIf(c.eq('r'), {
            parseStringInner(chars, index.add(2), actual.append('\r'))
        }).elseIf(c.eq('t'), {
            parseStringInner(chars, index.add(2), actual.append('\t'))
        }).else({
            InternalResult::Error("Invalid escape sequence")
        }).call
    }, {
        InternalResult::Error("Unterminated string")
    })
}

fn parseNumber(chars: Vec<char>, index: int) -> InternalResult {
    parseNumberRest(chars, index, "")
}

fn parseNumberRest(chars: Vec<char>, index: int, actual: str) -> InternalResult {
    chars.get(index).match(fn(c) {
        if(isNumber(c).or(c.eq('.')).or(c.eq('-')).or(c.eq('+')).or(c.eq('e')).or(c.eq('E')), {
            parseNumberRest(chars, index.add(1), actual.append(c))
        }, {
            finishNumber(actual, index)
        })
    }, {
        finishNumber(actual, index)
    })
}

fn finishNumber(s: str, index: int) -> InternalResult {
    if(s.contains('.').or(s.contains('e')).or(s.contains('E')), {
        s.toFloat.match(
            fn(f) { InternalResult::Ok(JsonFloat(f), index) },
            { InternalResult::Error("Cannot parse float: ".add(s)) })
    }, {
        s.toInt.match(
            fn(i) { InternalResult::Ok(JsonNumber(Number::Int(i)), index) },
            { InternalResult::Error("Cannot parse int: ".add(s)) })
    })
}

fn parseBoolean(chars: Vec<char>, index: int) -> InternalResult {
    parseBooleanRest(chars, index, "")
}

fn parseBooleanRest(chars: Vec<char>, index: int, actual: str) -> InternalResult {
    chars.get(index).match(fn(c) {
        if(c.isAlpha, {
            parseBooleanRest(chars, index.add(1), actual.append(c))
        }, {
            finishBoolean(actual, index)
        })
    }, {
        finishBoolean(actual, index)
    })
}

fn finishBoolean(actual: str, index: int) -> InternalResult {
    if(actual.eq("true"), {
        InternalResult::Ok(JsonBoolean(true), index)
    }).elseIf(actual.eq("false"), {
        InternalResult::Ok(JsonBoolean(false), index)
    }).else({
        InternalResult::Error("Invalid boolean: ".add(actual))
    }).call
}

fn parseNull(chars: Vec<char>, index: int) -> InternalResult {
    parseNullRest(chars, index, "")
}

fn parseNullRest(chars: Vec<char>, index: int, actual: str) -> InternalResult {
    chars.get(index).match(fn(c) {
        if(c.isAlpha, {
            parseNullRest(chars, index.add(1), actual.append(c))
        }, {
            finishNull(actual, index)
        })
    }, {
        finishNull(actual, index)
    })
}

fn finishNull(actual: str, index: int) -> InternalResult {
    if(actual.eq("null"), {
        InternalResult::Ok(JsonNull(), index)
    }, {
        InternalResult::Error("Invalid null: ".add(actual))
    })
}

fn parseObject(chars: Vec<char>, index: int) -> InternalResult {
    let i = skipSpaces(chars, index)
    chars.get(i).match(fn(c) {
        if(c.eq('}'), {
            InternalResult::Ok(JsonObject(Vec()), i.add(1))
        }, {
            parseObjectEntries(chars, i, Vec())
        })
    }, {
        InternalResult::Error("Unterminated object")
    })
}

fn parseObjectEntries(chars: Vec<char>, index: int, pairs: Vec<Pair<str,JsonValue>>) -> InternalResult {
    let start = skipSpaces(chars, index)
    parseKey(chars, start).match(
        fn(key, keyIndex) {
            let keyStr = key.matchJsonString(fn(s) { s }, { "" })
            let i = skipSpaces(chars, keyIndex)
            chars.get(i).match(fn(c) {
                if(c.eq(':'), {
                    parseValue(chars, i.add(1)).match(
                        fn(value, valueIndex) {
                            let newPairs = pairs.push(Pair(keyStr, value))
                            let j = skipSpaces(chars, valueIndex)
                            chars.get(j).match(fn(c2) {
                                if(c2.eq(','), {
                                    parseObjectEntries(chars, j.add(1), newPairs)
                                }).elseIf(c2.eq('}'), {
                                    InternalResult::Ok(JsonObject(newPairs), j.add(1))
                                }).else({
                                    InternalResult::Error("Expected ',' or '}' in object")
                                }).call
                            }, {
                                InternalResult::Error("Unterminated object")
                            })
                        },
                        fn(e) {
                            InternalResult::Error(e)
                        })
                }, {
                    InternalResult::Error("Expected ':' after object key")
                })
            }, {
                InternalResult::Error("Unterminated object")
            })
        },
        fn(e) {
            InternalResult::Error(e)
        })
}

fn parseKey(chars: Vec<char>, index: int) -> InternalResult {
    chars.get(index).match(fn(c) {
        if(c.eq('"'), {
            parseString(chars, index.add(1))
        }, {
            InternalResult::Error("Expected object key")
        })
    }, {
        InternalResult::Error("Unterminated object")
    })
}

fn parseArray(chars: Vec<char>, index: int) -> InternalResult {
    let i = skipSpaces(chars, index)
    chars.get(i).match(fn(c) {
        if(c.eq(']'), {
            InternalResult::Ok(JsonArray(Vec()), i.add(1))
        }, {
            parseArrayValues(chars, i)
        })
    }, {
        InternalResult::Error("Unterminated array")
    })
}


fn parseArrayValues(chars: Vec<char>, index: int) -> InternalResult {
    let initial = Pair(None<InternalResult>(), Pair(index, Vec<JsonValue>()))
    let finalCtx = while(initial, fn(ctx) {
        ctx.first.match(fn(done) {
            None()
        }, {
            let cur = ctx.second
            let curIndex = cur.first
            let curValues = cur.second
            parseValue(chars, curIndex).match(fn(value, valueIndex) {
                let newValues = curValues.push(value)
                let j = skipSpaces(chars, valueIndex)
                chars.get(j).match(fn(c) {
                    if(c.eq(','), {
                        let k = skipSpaces(chars, j.add(1))
                        chars.get(k).match(fn(c2) {
                            if(c2.eq(']'), {
                                Some(Pair(Some(InternalResult::Error("Trailing comma in array")), Pair(k, newValues)))
                            }, {
                                Some(Pair(None<InternalResult>(), Pair(k, newValues)))
                            })
                        }, {
                            Some(Pair(Some(InternalResult::Error("Unterminated array")), Pair(k, newValues)))
                        })
                    }).elseIf(c.eq(']'), {
                        Some(Pair(Some(InternalResult::Ok(JsonArray(newValues), j.add(1))), Pair(j.add(1), newValues)))
                    }).else({
                        Some(Pair(Some(InternalResult::Error("Expected ',' or ']' in array")), Pair(j, newValues)))
                    }).call
                }, {
                    Some(Pair(Some(InternalResult::Error("Unterminated array")), Pair(j, newValues)))
                })
            }, fn(e) {
                Some(Pair(Some(InternalResult::Error(e)), Pair(curIndex, curValues)))
            })
        })
    })
    finalCtx.first.match(fn(r) { r }, { InternalResult::Error("Unterminated array") })
}

fn contains(s: str, c: char) -> bool {
    s.charsVec.anyMatch(eq.curry(c))
}