pub enum Result<OK,ERROR> {
    Ok(value: OK),
    Error(error: ERROR)
}

pub fn map<OK,ERROR,T>(result: Result<OK,ERROR>, mapFun: fn(OK) -> T) -> Result<T,ERROR> {
    result.match(fn(value) { Ok(mapFun(value)) }, Error)
}

pub fn mapErr<OK,ERROR,T>(result: Result<OK,ERROR>, mapFun: fn(ERROR) -> T) -> Result<OK,T> {
    result.match(Ok, fn(e) { Error(mapFun(e)) })
}

pub fn flatten<OK,ERROR>(r: Result<Result<OK,ERROR>,ERROR>) -> Result<OK,ERROR> {
    r.match(identity, Error)
}

pub fn fmap<OK,ERROR,T>(l: Result<OK,ERROR>, f: fn(OK) -> Result<T,ERROR>) -> Result<T,ERROR> {
    l.match(f, Error)
}

pub fn forEach<OK,ERROR>(o: Result<OK,ERROR>, f: fn(OK) -> ()) {
    o.match(f, fn(ERROR) {})
}