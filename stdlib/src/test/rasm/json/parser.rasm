pub fn jsonParserSuite() -> TestSuite {
    TestSuite("json parser")
    .add("testStringParser", testStringParser)
    .add("testFullParser", testObjectParser)
    .add("testCompleteObjectParser", testCompleteObjectParser)
    .add("testAStructParser", testAStructParser)
    .add("testIntVecParser", testIntVecParser)
    //.add("testAStructVecParser", testAStructVecParser)
}

fn testStringParser() -> Assertions {
    let parseResult = jsonParse("\"Hello world\"")
    let assertions = Assertions()

    parseResult.match(
        fn(value) { assertions.assertEquals("", JsonString("Hello world"), value) }, 
        fn(error) { assertions.fail(error) })
    
}

fn testObjectParser() -> Assertions {
    let parseResult = jsonParse("[{\"x\" : 1, \"y\" : 20, \"v\" : 30}, {\"x\" : 2, \"y\" : 20, \"v\" : 30}]")
    let assertions = Assertions()

    parseResult.match(
        fn(ok) {
            let expected = JsonValue::JsonArray(vec!(
                JsonValue::JsonObject(vec!(
                    Pair("x", JsonValue::JsonNumber(Number::Int(1))),
                    Pair("y", JsonValue::JsonNumber(Number::Int(20))),
                    Pair("v", JsonValue::JsonNumber(Number::Int(30)))
                )),
                JsonValue::JsonObject(vec!(
                    Pair("x", JsonValue::JsonNumber(Number::Int(2))),
                    Pair("y", JsonValue::JsonNumber(Number::Int(20))),
                    Pair("v", JsonValue::JsonNumber(Number::Int(30)))
                ))
            ))
            assertions.assertEquals("", expected, ok)
         }, 
        fn(e) { 
            assertions.fail(e)
         }
    )
}

fn testCompleteObjectParser() -> Assertions {
    let parseResult = jsonParse("{\"string\" : \"Hello, World!\", \"number\" : 42, \"float\" : 0.5, \"boolean\" : true, \"null\" : null, \"array\" : [1, \"two\", false], \"object\" : {\"key\" : \"value\", \"nested\" : {\"number\" : 123}}}")
    let assertions = Assertions()

    parseResult.match(
        fn(ok) {
            let expected = JsonValue::JsonObject(vec!(
                Pair("string", JsonValue::JsonString("Hello, World!")),
                Pair("number", JsonValue::JsonNumber(Number::Int(42))),
                Pair("float", JsonValue::JsonFloat(0.5)),
                Pair("boolean", JsonValue::JsonBoolean(true)),
                Pair("null", JsonValue::JsonNull()),
                Pair("array", JsonValue::JsonArray(vec!(
                    JsonValue::JsonNumber(Number::Int(1)),
                    JsonValue::JsonString("two"),
                    JsonValue::JsonBoolean(false)
                ))),
                Pair("object", JsonValue::JsonObject(vec!(
                    Pair("key", JsonValue::JsonString("value")),
                    Pair("nested", JsonValue::JsonObject(vec!(
                        Pair("number", JsonValue::JsonNumber(Number::Int(123)))
                    )))
                )))
            ))
            assertions.assertEquals("", expected, ok)
        },
        fn(e) {
            assertions.fail(e)
        }
    )
}

fn testAStructParser() -> Assertions {
    let assertions = Assertions()

    let expected = AStruct(1, 20, 30)
    AStruct::parseJson<int>("{\"x\" : 1, \"y\" : 20, \"v\" : 30}").match(fn(as) {
        assertions.assertEquals("", expected, as)
    }, fn(e) {
        assertions.fail(e)
    })
}

fn testAStructVecParser() -> Assertions {
    let assertions = Assertions()

    let expected = vecOf(AStruct(1, 20, 30), AStruct(2, 20, 30))
    Vec::parseJson<AStruct<int>>("[{\"x\" : 1, \"y\" : 20, \"v\" : 30}, {\"x\" : 2, \"y\" : 20, \"v\" : 30}]").match(fn(as) {
        assertions.assertEquals("", expected, as)
    }, fn(e) {
        assertions.fail(e)
    })
}

fn testIntVecParser() -> Assertions {
    let assertions = Assertions()

    let expected = vecOf(10, 20)
    Vec::parseJson<int>("[10, 20]").match(fn(as) {
        assertions.assertEquals("", expected, as)
    }, fn(e) {
        assertions.fail(e)
    })
}

fn int::parseJson(jv: JsonValue) -> Result<int, str> {
        jv.matchJsonNumber(fn(n) {
        n.match(fn(i) {
            Result::Ok(i)
        }, fn(f) {
            Result::Error("Expected int, found float")    
        })
    }, {
        Result::Error("Expected int")
    })
}

fn AStruct::parseJson<T>(s: str) -> Result<AStruct<T>, str> {
    s.jsonParse.fmap(fn(jsonValue) {
        AStruct::parseJson<T>(jsonValue)
    })
}

fn AStruct::parseJson<T>(jv: JsonValue) -> Result<AStruct<T>, str> {
    jv.matchJsonObject(
        fn(values) {
            values.oneOrError("x").fmap(fn(jvx) {
                values.oneOrError("y").fmap(fn(jvy) {
                    values.oneOrError("v").fmap(fn(jvv) {
                        int::parseJson(jvx).fmap(fn(pvx) {
                            int::parseJson(jvy).fmap(fn(pvy) {
                                T::parseJson(jvv).map(fn(pvv) {
                                    AStruct(pvx, pvy, pvv)
                                })
                            }
                        })
                    }
                })
            })
        }, 
        fn() { Result::Error("expected object") }
    )
}

fn Vec::parseJson<T>(s: str) -> Result<Vec<T>, str> {
    s.jsonParse.fmap(fn(jsonValue) {
        Vec::parseJson<T>(jsonValue)
    })
}

fn Vec::parseJson<T>(jv: JsonValue) -> Result<Vec<T>, str> {
    jv.matchJsonArray(fn(a) {
        a.foldLeft(Result::Ok(Vec<T>()), fn(result, actual) {
            result.fmap(fn(vector) {
                T::parseJson(actual).map(fn(parsedActual) {
                    vector.push(parsedActual)
                })
            })
        })
    }, fn() {
        Result::Error("Expected array")
    })
}

fn oneOrError(values: Vec<Pair<str,JsonValue>>, key: str) -> Result<JsonValue, str> {
    let found = values.filter(fn(it) {it.first.eq(key)})
    if(found.len.eq(1), {
        found.first.match(fn(it) {
            Result::Ok(it.second)
        }, {
            Result::Error("It should not happen")
        })
    }, {
        Result::Error("Cannot find property: ".add(key))
    })
}