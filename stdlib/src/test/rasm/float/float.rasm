pub fn floatSuite() -> TestSuite {
    TestSuite("float")
    .add("strToFloat", strToFloat)
    .add("intToFloat", intToFloat)
}

fn strToFloat() -> Assertions {
    Assertions()
    .assertEquals(Some(-123456), "-123.456".strToFloat(3))
    .assertEquals(Some(0), "0.0".strToFloat(0))
}

fn intToFloat() -> Assertions {
    Assertions()
    .assertEquals(-1.0, -1.toFloat)
    .assertEquals(0.0, 0.toFloat)
}

fn strToFloat(s: str, n: int) -> Option<int> {
    s.toFloat.fmap(fn(f) { f.mul(pow10(n)).toInt })
}