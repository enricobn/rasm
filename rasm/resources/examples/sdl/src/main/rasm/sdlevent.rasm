pub const SDLReleased = 0
pub const SDLPressed = 1

pub struct SDLKeysym {
    scancode: int,
    sym: int,
    mod: int
}

pub enum SDLEvent {
    SDLKeyboardEvent(timestamp: int, windowID: int, state: int, repeat: bool, keysym: SDLKeysym),
    SDLQuitEvent(timestamp: int)
}

pub fn sdlPollEvents() -> Vec<SDLEvent> {
    sdlPollEvents(Vec())
}

fn sdlPollEvents(events: Vec<SDLEvent>) -> Vec<SDLEvent> {
    sdlPollEvent()
        .match(fn(event) {
                sdlPollEvents(events.push(event))
            }, { events }
        )
}