pub type SDLColor /{ hasReferences = true }/

pub fn SDLColor(r: int, g: int, b: int, a: int) -> SDLColor /{
    push    ebx
    $call(rasmalloc, 4, " for SDLColor")
    push    eax
    mov     eax,[eax]
    mov     dword ebx, $r
    mov     byte [eax],bl

    mov     dword ebx, $g
    mov     byte [eax + 1],bl

    mov     dword ebx, $b
    mov     byte [eax + 2],bl

    mov     dword ebx, $a
    mov     byte [eax + 3],bl
    pop     eax
    pop     ebx
}/

pub fn r(color: SDLColor) -> int /{
    mov     dword eax, $color
    mov     dword eax, [eax]
    mov     byte al, [eax]
    and     eax,0xFF
}/

pub fn g(color: SDLColor) -> int /{
    mov     dword eax, $color
    mov     dword eax, [eax]
    mov     byte al, [eax + 1]
    and     eax,0xFF
}/

pub fn b(color: SDLColor) -> int /{
    mov     dword eax, $color
    mov     dword eax, [eax]
    mov     byte al, [eax + 2]
    and     eax,0xFF
}/

pub fn a(color: SDLColor) -> int /{
    mov     dword eax, $color
    mov     dword eax, [eax]
    mov     byte al, [eax + 3]
    and     eax,0xFF
}/