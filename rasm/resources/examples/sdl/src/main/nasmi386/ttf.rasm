pub type TTFFont /{ hasReferences = false }/

pub fn ttfInit() -> int /{
    $ccall(TTF_Init)
}/

pub fn ttfQuit() /{
    $ccall(TTF_Quit)
}/

pub fn ttfOpenFont(file: str, size: int) -> Result<TTFFont,str> /{
    $ccall(TTF_OpenFont, $file, $size)
    ; TODO error check
    $call(Ok<TTFFont,str>, eax: TTFFont)
}/

pub fn ttfCloseFont(font: TTFFont) /{
    $ccall(TTF_CloseFont, $font)
}/

pub fn sdlRenderTextSolid(font: TTFFont, message: str, color: SDLColor) -> SDLSurface /{
    push    ecx

    mov     dword ecx, $color
    mov     dword ecx, [ecx]

    $ccall(TTF_RenderText_Solid, $font, $message, [ecx])

    pop     ecx
}/