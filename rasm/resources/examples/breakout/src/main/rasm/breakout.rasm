pub enum GameResult {
    Play(state: GameState),
    End(score: int)
}

@json()
pub struct HighScore {
    score: int,
    time: TimeVal
}

@json()
pub struct State {
    keys: Vec<int>,
    stage: Stage,
    highScores: Vec<HighScore>
}

@json()
pub enum Stage {
    Menu(menuState: MenuState),
    Game(gameState: GameState)
}

pub struct Colors {
    black: RGBAColor,
    blue: RGBAColor,
    green: RGBAColor,
    red: RGBAColor,
    yellow: RGBAColor,
    white: RGBAColor
}

pub fn Colors() -> Colors {
    Colors(
        RGBAColor(0, 0, 0, 255),
        RGBAColor(0, 0, 255, 255),
        RGBAColor(0, 255, 0, 255),
        RGBAColor(255, 0, 0, 255),
        RGBAColor(255, 255, 0, 255),
        RGBAColor(255, 255, 255, 255)
    )
}

enum Message {
    KeyPressed(scancode: int),
    KeyReleased(scancode: int),
    Quit,
    Tick
}

pub const WIDTH = 1024
pub const HEIGHT = 768
pub const BRICKWIDTH = 34
pub const BRICKHEIGHT = 10
pub const BARWIDTH = 80
pub const BARHEIGHT = 10
pub const BARY = HEIGHT.sub(BARHEIGHT)
pub const HEADERHEIGHT = 30
pub const BALLSIZE = 5
pub const COLORS = Colors()
pub const FONT = "DejaVuSerif"

let highScores = loadHighScores()
let initialState = State(Vec(), Menu(MenuState(highScores)), highScores)

Rasm2DApplication()
.width(1024)
.height(768)
.title("Breakout")
.loadFont(FONT, resource("DejaVuSerif.ttf"), 24)
.run(initialState, update, render, subscriptions)

fn update(state: State, message: Message) -> State {
    let keys = state.keys
    let stage = state.stage
    let highScores = state.highScores

    let newKeys = message.match(
        fn(scancode) {
            keys.push(scancode)
        }, fn(scancode) {
            keys.filter(neq.curry(scancode))
        }, fn() {
            exitMain(0)
            Vec()
        }, {
           keys 
        })

    match(stage, 
        fn(menuState) {
            let newStage = update(newKeys, menuState)
            State(newKeys, newStage, highScores)
        }, 
        fn(gameState) {
            let gameResult = update(newKeys, gameState)
            gameResult.match(
                fn(newGameState) { State(newKeys, Game(newGameState), highScores)}, 
                fn(score) {
                    let newHighScores = highScores.add(score)
                    writeHighScores(newHighScores)
                    State(newKeys, Menu(MenuState(newHighScores)), newHighScores)
                }
            )
        }
    )
}

fn add(highScores: Vec<HighScore>, score: int) -> Vec<HighScore> {
    highScores.push(HighScore(score, now()))
}

fn render(graphics: Rasm2DGraphics, state: State) {
    graphics.setColor(COLORS.black)
    graphics.clear()

    state.stage.match(
        fn(menuState) { graphics.render(menuState)}, 
        fn(gameState) { graphics.render(gameState)}
    )
}

fn subscriptions(events: Rasm2DEvents) -> Vec<Message> {
    if(events.quit().or(events.keyPressed(41)), { // 41 == ESC
        vecOf(Quit())
    }, {
        let keys = events.keyPressed.map(KeyPressed)
            .add(events.keyReleased.map(KeyReleased))
        iif(keys.isEmpty, vecOf(Tick()), keys)
    })
}

fn loadHighScores() -> Vec<HighScore> {
    if(fileExists("scores.txt"), {
        readFile("scores.txt").match(fn(scores) {
            let lines = scores.lines
            lines.fmap(fn(line) {
                let splitted = line.splitToList(',')
                splitted.map3(fn(score, sec, nano) {
                    score.toInt.fmap(fn(sc) {
                        sec.toInt.fmap(fn(s) {
                            nano.toInt.map(fn(n) {
                                HighScore(sc, TimeVal(s, n))
                            })
                        })
                    })
                }).flatten.toList
            }).toVec
        }, fn(err) {
            println("Error reading scores.txt:".append(err))
            Vec()
        })
    }, Vec)
}

fn printHighScores(highScores: Vec<HighScore>) {
    forEach(highScores, fn(highScore) {
        print("high score ", highScore.score)
        print(", ")
        println(highScore.time)
    })
}

fn writeHighScores(highScores: Vec<HighScore>) {
    createFile("scores.txt", fn(file) {
        highScores.foldLeft(Option::None<IOError>(), fn(accum, actual) {
            accum.orElse({ print(file, actual.score) })
                .orElse({ print(file, ",") })
                .orElse({ print(file, actual.time.sec) })
                .orElse({ print(file, ",") })
                .orElse({ println(file, actual.time.nano) })
        })
    }).match(
        fn(err) {
            println("Error creating scores.txt: ".append(err))
            exitMain(1)
        },
        fn() { }, 
    )
}