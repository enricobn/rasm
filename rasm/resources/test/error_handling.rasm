argv(1).match(fn (fileName) {
    createFile(fileName, fn(file) {
        println(file, 'c').or(println(file, "Hello"))
    }).match(fn(err) { Error(err) }, { 
        readFile(fileName)        
     }).match(fn (ok) {
        print(ok)
     }, fn (err) {
        println(err)
     })
}, {
   panic("No file specified")
})