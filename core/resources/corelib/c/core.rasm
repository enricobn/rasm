pub type RasmPointer /{
    hasReferences = false,
    nativeType = struct RasmPointer_*
}/

pub fn exitMain(status: int) /{
    exit($status);
}/

pub fn argc() -> int /{
    return argc_;
}/

pub fn argv(i: int) -> Option<str> /{
    if (i >= argc_) {
        return $call(Option::None<str>);
    } else {
        struct RasmPointer_ *argv = addStaticStringToHeap(argv_[$i]);
        $addRef(argv:str)
        return
        $call(Some, argv:str)
        ;
    }

}/